# Infrastructure (required before the app can read its database-backed config)
DB_HOST=db
DB_PORT=3306
DB_NAME=homeline
DB_USER=homeline
DB_PASS=replace-with-a-strong-password
DB_ROOT_PASS=replace-with-a-different-strong-password
AUTO_MIGRATE=1
SEED_GOD=1

# Generate once with: openssl rand -base64 32
CONFIG_ENCRYPTION_KEY=

# Application settings are normally entered in God Mode after first sign-in.
# They may be exported for automated bootstrapping; database values win.
# APP_BASE_URL=https://homeline.example.com
# TELNYX_API_KEY=KEY...
# TELNYX_TEXML_APP_ID=
# TELNYX_MESSAGING_PROFILE_ID=
# TELNYX_PUBLIC_KEY=
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET=
